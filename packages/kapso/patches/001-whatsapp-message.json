      "op": "add",
      "path": "/shapes/com.kapso.whatsapp#InteractiveMessage",
      "value": {
        "type": "structure",
        "members": {
          "type": {
            "target": "com.kapso.whatsapp#InteractiveMessageType",
            "traits": {
              "smithy.api#documentation": "Interactive message type:\n- button: Reply buttons (up to 3)\n- list: List picker (up to 10 rows across sections)\n- flow: WhatsApp Flow integration\n- cta_url: Call-to-action URL button\n- carousel: Free-form media carousel with 2-10 cards\n- location_request_message: Request user's location\n- request_contact_info: Request user's phone number and contact info\n- address_message: Address collection (India only)\n- order_details: Order for the user to review and pay (Brazil Pix)\n- order_status: Status update for a previously sent order\n- product: Single product message\n- product_list: Multi-product message (up to 30 products)\n- call_permission_request: Request permission to call\n- catalog_message: Browse full catalog\n- voice_call: Button the user taps to call your business on WhatsApp",
              "smithy.api#required": {}
            }
          },
          "body": {
            "target": "com.kapso.whatsapp#InteractiveMessageBody",
            "traits": {
              "smithy.api#documentation": "Message body text.\nRequired for all types except location_request_message (where it's optional)."
            }
          },
          "header": {
            "target": "com.kapso.whatsapp#InteractiveMessageHeader"
          },
          "footer": {
            "target": "com.kapso.whatsapp#InteractiveMessageFooter"
          },
          "action": {
            "target": "com.kapso.whatsapp#InteractiveMessageAction",
            "traits": {
              "smithy.api#documentation": "Action definition. Structure varies by interactive type.\n\nNOTE: The structure of the action object varies by type:\n- type=button: Requires `buttons` array\n- type=list: Requires `button` (string) and `sections` array\n- type=flow: Requires `name=\"flow\"` and `parameters` with flow config\n- type=cta_url: Requires `name=\"cta_url\"` and `parameters` with display_text and url\n- type=carousel: Requires `cards` array with 2-10 media cards. Top-level header/footer are not supported.\n- type=location_request_message: Requires `name=\"send_location\"`\n- type=request_contact_info: Requires `name=\"request_contact_info\"`\n- type=address_message: Requires `name=\"address_message\"` and `parameters` with country\n- type=order_details: Requires `name=\"review_and_pay\"` and a `parameters` object\n- type=order_status: Requires `name=\"review_order\"` and a `parameters` object\n- type=voice_call: Requires `name=\"voice_call\"`. `parameters` is optional.",
              "smithy.api#required": {}
            }
          }
        },
        "traits": {}
      }
    },
