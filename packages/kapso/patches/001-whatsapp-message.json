      "value": {
        "type": "structure",
        "members": {
          "buttons": {
            "target": "com.kapso.whatsapp#InteractiveMessageActionButtonsList",
            "traits": {
              "smithy.api#documentation": "Reply buttons (for type=button).\nMinimum 1, maximum 3 buttons."
            }
