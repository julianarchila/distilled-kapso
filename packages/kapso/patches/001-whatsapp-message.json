{
  "description": "Type sendMessage's message body. The spec's WhatsappMessage schema has `properties` and `anyOf: [{ required: [to] }, { required: [recipient] }]`, which only says a send names `to` or `recipient`. The converter reads that anyOf as a union with no properties and turns the message into a Document, so sendMessage took `unknown`. These are the shapes the converter emits for WhatsappMessage with the anyOf ignored (generated by scripts/derive-whatsapp-message-patch.ts). A live text send of 2026-11-17 with these members was accepted.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.kapso.whatsapp#WhatsappMessage",
      "value": {
        "type": "structure",
        "members": {
          "messaging_product": {
            "target": "com.kapso.whatsapp#WhatsappMessageMessagingProduct",
            "traits": {
              "smithy.api#documentation": "Always \"whatsapp\"",
              "smithy.api#required": {}
            }
          },
          "recipient_type": {
            "target": "com.kapso.whatsapp#WhatsappMessageRecipientType",
            "traits": {
              "smithy.api#documentation": "Recipient type. Use `individual` for 1:1, `group` for group messages.\nWhen `group`, `to` must be a Group ID obtained via the Groups API."
            }
          },
          "biz_opaque_callback_data": {
            "target": "smithy.api#String",
            "traits": {
              "smithy.api#documentation": "Arbitrary string for tracking (echoed in webhooks)"
            }
          },
          "messaging_account_id": {
            "target": "smithy.api#String",
            "traits": {
              "smithy.api#documentation": "Optional Messaging Account (WhatsApp Business Account) ID to send from.\nMust match the account the `phone_number_id` is configured with, otherwise\nthe request is rejected with `messaging_account_mismatch`."
            }
          },
          "paid_messaging_account_id": {
            "target": "smithy.api#String",
            "traits": {
              "smithy.api#documentation": "Deprecated alias for `messaging_account_id`. Ignored when\n`messaging_account_id` is also present."
            }
          },
          "to": {
            "target": "smithy.api#String",
            "traits": {
              "smithy.api#documentation": "Recipient phone number or group ID. Use `recipient` for BSUID sends."
            }
          },
          "recipient": {
            "target": "smithy.api#String",
            "traits": {
              "smithy.api#documentation": "Recipient BSUID or parent BSUID. If `to` is also present, the phone number in `to` takes precedence."
            }
          },
          "type": {
            "target": "com.kapso.whatsapp#MessageType",
            "traits": {
              "smithy.api#required": {}
            }
          },
          "context": {
            "target": "com.kapso.whatsapp#WhatsappMessageContext",
            "traits": {
              "smithy.api#documentation": "Reply context"
            }
          },
          "text": {
            "target": "com.kapso.whatsapp#TextMessage"
          },
          "image": {
            "target": "com.kapso.whatsapp#MediaMessage"
          },
          "video": {
            "target": "com.kapso.whatsapp#MediaMessage"
          },
          "audio": {
            "target": "com.kapso.whatsapp#AudioMessage"
          },
          "document": {
            "target": "com.kapso.whatsapp#MediaMessage"
          },
          "sticker": {
            "target": "com.kapso.whatsapp#MediaMessage"
          },
          "location": {
            "target": "com.kapso.whatsapp#LocationMessage"
          },
          "contacts": {
            "target": "com.kapso.whatsapp#WhatsappMessageContactsList"
          },
          "interactive": {
            "target": "com.kapso.whatsapp#InteractiveMessage"
          },
          "template": {
            "target": "com.kapso.whatsapp#TemplateMessage"
          },
