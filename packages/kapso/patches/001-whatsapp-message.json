          "sections": {
            "target": "com.kapso.whatsapp#InteractiveMessageActionSectionsList",
            "traits": {
              "smithy.api#documentation": "List sections (for type=list).\nMaximum 10 sections, maximum 10 rows total across all sections."
            }
          },
          "cards": {
            "target": "com.kapso.whatsapp#InteractiveMessageActionCardsList",
            "traits": {
              "smithy.api#documentation": "Carousel cards (for type=carousel). Each card must include a media header\nwith image or video and all cards must use the same button structure:\neither one CTA URL button per card, or the same number of quick-reply\nbuttons per card."
            }
          },
          "name": {
            "target": "com.kapso.whatsapp#InteractiveMessageActionName",
            "traits": {
              "smithy.api#documentation": "Action name.\n- \"cta_url\" for CTA URL buttons\n- \"send_location\" for location requests\n- \"request_contact_info\" for phone number/contact info requests\n- \"address_message\" for address collection\n- \"flow\" for WhatsApp Flows\n- \"call_permission_request\" for call permission request\n- \"catalog_message\" for catalog browse\n- \"voice_call\" for the WhatsApp call button"
            }
          },
          "parameters": {
            "target": "com.kapso.whatsapp#InteractiveMessageActionParameters",
            "traits": {
              "smithy.api#documentation": "Parameters object (structure varies by action name)."
            }
          }
        },
        "traits": {
          "smithy.api#documentation": "Action definition. Structure varies by interactive type.\n\nNOTE: The structure of the action object varies by type:\n- type=button: Requires `buttons` array\n- type=list: Requires `button` (string) and `sections` array\n- type=flow: Requires `name=\"flow\"` and `parameters` with flow config\n- type=cta_url: Requires `name=\"cta_url\"` and `parameters` with display_text and url\n- type=carousel: Requires `cards` array with 2-10 media cards. Top-level header/footer are not supported.\n- type=location_request_message: Requires `name=\"send_location\"`\n- type=request_contact_info: Requires `name=\"request_contact_info\"`\n- type=address_message: Requires `name=\"address_message\"` and `parameters` with country\n- type=order_details: Requires `name=\"review_and_pay\"` and a `parameters` object\n- type=order_status: Requires `name=\"review_order\"` and a `parameters` object\n- type=voice_call: Requires `name=\"voice_call\"`. `parameters` is optional."
        }
